[
 {
  "id": "f01",
  "a": 61.08,
  "b": 64.58,
  "text": "第一句是诗篇的第一百四十五篇第三节"
 },
 {
  "id": "f02",
  "a": 197.62,
  "b": 201.3,
  "text": "孩子在哪个学校上学"
 },
 {
  "id": "f03",
  "a": 212.31,
  "b": 213.93,
  "text": "这并不丢人"
 },
 {
  "id": "f04",
  "a": 376.7,
  "b": 379.63,
  "text": "这句子，几乎又把上文抄了一遍"
 },
 {
  "id": "f05",
  "a": 392.87,
  "b": 396.12,
  "text": "身上写着：神阻挡骄傲的人"
 },
 {
  "id": "f06",
  "a": 516.56,
  "b": 519.52,
  "text": "神在你们心里运行"
 },
 {
  "id": "f07",
  "a": 527.67,
  "b": 528.75,
  "text": null
 },
 {
  "id": "f08",
  "a": 660.75,
  "b": 662.83,
  "text": "因为你造我们是为了你"
 },
 {
  "id": "f09",
  "a": 983.12,
  "b": 985.83,
  "text": "请使我得知并理解"
 },
 {
  "id": "f10",
  "a": 1263.75,
  "b": 1266.14,
  "text": "他并没有一咬牙下定决心"
 },
 {
  "id": "f11",
  "a": 1391.69,
  "b": 1394.42,
  "text": "把气吹进他的鼻孔里"
 },
 {
  "id": "f12",
  "a": 1492.38,
  "b": 1497.31,
  "text": "一个心思压根儿不在内容上的修辞学教授"
 }
]