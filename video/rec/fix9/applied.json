[
 {
  "id": "f01",
  "a": 86.58,
  "b": 89.08,
  "text": "讲第二条诫命的时候说",
  "tts_s": 2.12
 },
 {
  "id": "f02",
  "a": 139.27,
  "b": 143.91,
  "text": "是否你充塞天地后，还有不能被天地包容的部分？",
  "tts_s": 4.59
 },
 {
  "id": "f03",
  "a": 207.58,
  "b": 211.0,
  "text": "因为你充塞一切，亦即是包容一切？",
  "tts_s": 3.37
 },
 {
  "id": "f04",
  "a": 304.52,
  "b": 308.1,
  "text": "神也没有被这只瓶子固定住。",
  "tts_s": 2.67
 },
 {
  "id": "f05",
  "a": 396.41,
  "b": 398.01,
  "text": "托着你的那一位，",
  "tts_s": 1.54
 },
 {
  "id": "f06",
  "a": 658.73,
  "b": 662.04,
  "text": "因之占有你的部分多，",
  "tts_s": 2.35
 },
 {
  "id": "f07",
  "a": 662.04,
  "b": 666.47,
  "text": "如此你便为世界各部分所分割，",
  "tts_s": 3.48
 }
]